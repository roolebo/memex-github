#!/usr/bin/env bash
#
# test/run: tests of memex-github against a fake GitHub.
#
# test/bin comes first in PATH: its curl answers from test/fixtures and
# logs every request, and its gh has a token only when a test gives it
# one, so no test reaches a network. HOME is a scratch directory, so the
# user's ~/.netrc stays unread.
#

set -e

CURDIR=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
ROOT=$(dirname "$CURDIR")
ADAPTER=$ROOT/memex-github
ADDR=https://github.com/example/widget
API=https://api.github.com
REPO=$API/repos/example/widget
GRAPHQL=$API/graphql
A=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
B=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
C=cccccccccccccccccccccccccccccccccccccccc
DIR=$(mktemp -d)
FAILED=0
# A token the tests look for in curl's arguments
TOKEN=t0ken

die() {
  echo "$*" >&2
  exit 1
}

usage() {
  cat << EOF
Usage: $0 [TEST...]

Runs the given tests, or all of them:
$(declare -F | cut -d' ' -f3 | grep '^test_' | sed 's/^/  /')
EOF
}

cleanup() {
  rm -rf "$DIR"
}

# Answer METHOD on URL with FIXTURE, - for none, and STATUS, when the
# body contains MATCH
route() {
  printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "${4:-200}" "$5" \
    >> "$FAKE_ROUTES"
}

# Answer GraphQL queries whose body contains MATCH with FIXTURE
graphql() {
  route POST "$GRAPHQL" "$1" 200 "$2"
}

# Use the token from the environment
login() {
  export GITHUB_TOKEN=$TOKEN
  graphql viewer.json 'viewer { login }'
}

# Run the adapter on ADDR with ARGS; sets OUT, ERR and STATUS
call() {
  OUT=$(cd "$TEST_DIR" && "$ADAPTER" "$ADDR" "$@" 2> "$TEST_DIR/err") &&
    STATUS=0 || STATUS=$?
  ERR=$(< "$TEST_DIR/err")
}

# Apply a jq FILTER to OUT, one record at a time, or to all with -s
q() {
  jq -c "$@" <<< "$OUT"
}

# The record with id ID in OUT
record() {
  q "select(.id == \"$1\")"
}

# Apply a jq FILTER to the logged requests, as an array
log() {
  jq -sc "$1" "$FAKE_LOG"
}

# The logged requests as METHOD URL, one per line
requests() {
  jq -r 'select(.method) | "\(.method) \(.url)"' "$FAKE_LOG"
}

# The body of the first logged request with METHOD
body() {
  log "map(select(.method == \"$1\"))[0].body | fromjson"
}

# JSON in one line, as jq -c prints it
json() {
  jq -c . <<< "$1"
}

check() {
  [ "$2" == "$3" ] && return
  echo "# $TEST: $1: expected '$3', got '$2'"
  FAILED=$((FAILED + 1))
}

check_has() {
  [[ "$2" == *"$3"* ]] && return
  echo "# $TEST: $1: '$2' lacks '$3'"
  FAILED=$((FAILED + 1))
}

test_capabilities() {
  call discussion capabilities
  check discussion "$(q .)" "$(json '{"exact": true, "resolved": true,
    "drafts": false, "series": false, "votes": true}')"
  call tracker capabilities
  check tracker "$(q .)" \
    '{"search":true,"comment":true,"transition":true}'
  call ci capabilities
  check ci "$(q .)" '{"tests":false,"logs":true,"retest":true,"bugs":false}'
  check requests "$(requests)" ""
}

test_unsupported() {
  local command
  call code capabilities
  check role "$STATUS" 2
  call discussion series 7
  check series "$STATUS" 2
  for command in drafts draft discard publish; do
    call discussion $command 7
    check $command "$STATUS" 2
  done
  call tracker frobnicate 12
  check tracker "$STATUS" 2
  call ci tests 9001
  check ci "$STATUS" 2
  check requests "$(requests)" ""
}

test_bad_usage() {
  local ADDR=https://github.com/example
  call discussion capabilities
  check addr "$STATUS" 1
  check_has message "$ERR" "Not a GitHub repository URL"
  ADDR=https://github.com/example/widget
  call discussion change abc
  check change "$STATUS" 1
  call tracker issue abc
  check issue "$STATUS" 1
  call ci runs 'HEAD~1'
  check commit "$STATUS" 1
  call tracker transition 12 reopened
  check transition "$STATUS" 1
  check_has message "$ERR" "No such status: reopened"
  check requests "$(requests)" ""
}

# The routes of pull request 7
pull_request() {
  graphql pr.json latestOpinionatedReviews
  graphql pushes.json timelineItems
}

test_change() {
  login
  pull_request
  call discussion change 7
  check status "$STATUS" 0
  check records "$(q -s length)" 1
  check envelope "$(q '[.id, .source, .role, .kind, .links, .notes]')" \
    "$(json '["7", "https://github.com/example/widget", "discussion",
      "change", [["change", "7"]], {}]')"
  check basis "$(q -r .basis)" "$C 2026-09-05T12:00:00Z"
  check title "$(q .data.title)" "\"Fix the widget's lock\""
  check url "$(q .data.url)" '"https://github.com/example/widget/pull/7"'
  check status "$(q .data.status)" '"open"'
  check owner "$(q .data.owner)" "$(json '{"name": "Alice Author",
    "email": "alice@example.org", "username": "alice", "me": true}')"
  check message "$(q .data.message)" '"The lock leaked on the error path."'
  check variables "$(log '[.[] | select(.method) | .body | fromjson
    | .variables] | unique')" "$(json '[
    {}, {"owner": "example", "name": "widget", "number": 7}]')"
}

# A revision for each commit a force-push replaced or brought, oldest
# first; only the newest can be fetched
test_change_revisions() {
  login
  pull_request
  call discussion change 7
  check ids "$(q '[.data.revisions[].id]')" "[\"$A\",\"$B\",\"$C\"]"
  check current "$(q -r .data.current)" "$C"
  check created "$(q '[.data.revisions[].created]')" "$(json '[
    "2026-09-01T09:00:00Z", "2026-09-02T10:00:00Z",
    "2026-09-04T10:05:00Z"]')"
  check uploaders "$(q '[.data.revisions[].uploader.username]')" \
    '["alice","alice","bob"]'
  check fetch "$(q '[.data.revisions[].fetch]')" \
    '[null,null,"refs/pull/7/head"]'
  check parents "$(q '.data.revisions[0] | [.commit, .parents]')" \
    "[\"$A\",[\"9999999999999999999999999999999999999999\"]]"
}

# Approvals and change requests; a missing name or email falls back
test_change_votes() {
  login
  pull_request
  call discussion change 7
  check votes "$(q '[.data.votes[] | [.label, .value, .by.username]]')" \
    '[["approved",1,"bob"],["approved",-1,"dan"]]'
  check by "$(q '.data.votes[1].by')" \
    '{"name":"dan","email":null,"username":"dan","me":false}'
}

# A deleted author is GitHub's ghost
test_change_closed() {
  login
  graphql pr-closed.json latestOpinionatedReviews
  graphql empty-page.json timelineItems
  call discussion change 8
  check status "$STATUS" 0
  check status "$(q .data.status)" '"abandoned"'
  check owner "$(q .data.owner)" \
    '{"name":"ghost","email":null,"username":"ghost","me":false}'
  check revisions "$(q '[.data.revisions[] | [.id, .created, .fetch]]')" \
    "[[\"$A\",\"2026-09-02T09:00:00Z\",\"refs/pull/8/head\"]]"
}

test_change_missing() {
  login
  graphql pr-missing.json latestOpinionatedReviews
  call discussion change 99
  check status "$STATUS" 1
  check_has stderr "$ERR" "Could not resolve to a PullRequest"
}

test_change_needs_token() {
  call discussion change 7
  check status "$STATUS" 1
  check_has stderr "$ERR" "The GraphQL API needs a token"
  check requests "$(requests)" ""
}

test_locate() {
  login
  route GET "$REPO/commits/$C/pulls" commit-pulls.json
  pull_request
  call discussion locate "$C"
  check status "$STATUS" 0
  check id "$(q .id)" '"7"'
}

test_locate_none() {
  route GET "$REPO/commits/$C/pulls" empty-list.json
  call discussion locate "$C"
  check status "$STATUS" 1
  check_has stderr "$ERR" "No pull request has commit $C"
  check auth "$(log '[.[].auth | select(.)]')" '["none"]'
}

# The token goes on stdin
test_token() {
  login
  pull_request
  call discussion change 7
  check status "$STATUS" 0
  check auth "$(log '[.[].auth | select(.)] | unique')" '["stdin"]'
  check config "$(jq -sr '.[0].config' "$FAKE_LOG")" \
    "header = \"Authorization: bearer $TOKEN\""
  check args "$(log "[.[].args[]? | select(contains(\"$TOKEN\"))]")" '[]'
  check gh "$(log '[.[].gh | select(.)]')" '[]'
}

test_gh_token() {
  export FAKE_GH_TOKEN=$TOKEN
  graphql viewer.json 'viewer { login }'
  pull_request
  call discussion change 7
  check status "$STATUS" 0
  check gh "$(log '[.[].gh | select(.)]')" \
    '[["auth","token","--hostname","github.com"]]'
  check config "$(jq -sr 'map(select(.method))[0].config' "$FAKE_LOG")" \
    "header = \"Authorization: bearer $TOKEN\""
}

test_netrc() {
  printf 'machine api.github.com login u password %s\n' "$TOKEN" \
    > "$HOME/.netrc"
  graphql viewer.json 'viewer { login }'
  pull_request
  call discussion change 7
  check status "$STATUS" 0
  check auth "$(log '[.[].auth | select(.)] | unique')" '["netrc"]'
}

# GitHub Enterprise serves its API on the host of ADDR
test_enterprise() {
  local ADDR=https://ghe.example.com/example/widget
  local GRAPHQL=https://ghe.example.com/api/graphql
  local REPO=https://ghe.example.com/api/v3/repos/example/widget
  export FAKE_GH_TOKEN=$TOKEN
  graphql viewer.json 'viewer { login }'
  route GET "$REPO/commits/$C/pulls" commit-pulls.json
  pull_request
  call discussion locate "$C"
  check status "$STATUS" 0
  check source "$(q .source)" '"https://ghe.example.com/example/widget"'
  check gh "$(log '[.[].gh | select(.)][0][-1]')" '"ghe.example.com"'
}

# The routes of the threads of pull request 7, over two pages
threads() {
  graphql threads-2.json '"after":"threads-2"'
  graphql threads-1.json reviewThreads
  graphql conversation.json 'page: comments'
  graphql reviews.json 'page: reviews'
}

test_threads() {
  login
  threads
  call discussion threads 7
  check status "$STATUS" 0
  check "oldest first" "$(q -s '[.[].id]')" "$(json '["IC_1", "PRRC_1",
    "PRRC_4", "PRRC_5", "IC_2", "PRR_1"]')"
  check envelope "$(record PRRC_1 | jq -c '[.source, .role, .kind,
    .links, .notes]')" "$(json '["https://github.com/example/widget",
    "discussion", "thread", [["change", "7"]], {}]')"
  check pages "$(log '[.[] | select(.method) | .body | fromjson
    | .variables.after // empty]')" '["threads-2"]'
}

test_threads_anchors() {
  login
  threads
  call discussion threads 7
  check lines "$(record PRRC_1 | jq -c .data.anchor)" "$(json '{
    "on": "lines", "path": "src/lock.c", "side": "revision",
    "start": 10, "end": 12}')"
  check file "$(record PRRC_4 | jq -c .data.anchor)" \
    '{"on":"file","path":"src/widget.c"}'
  check base "$(record PRRC_5 | jq -c .data.anchor)" "$(json '{
    "on": "lines", "path": "src/lock.c", "side": "base",
    "start": 7, "end": 7}')"
  check conversation "$(record IC_1 | jq -c .data.anchor)" '{"on":"change"}'
  check review "$(record PRR_1 | jq -c .data.anchor)" '{"on":"change"}'
}

# Pending comments and reviews are drafts: threads leaves them out
test_threads_comments() {
  login
  threads
  call discussion threads 7
  check replies "$(record PRRC_1 | jq -c '[.data.comments[]
    | [.id, .reply_to, .revision, .author.me]]')" "$(json "[
    [\"PRRC_1\", null, \"$A\", false],
    [\"PRRC_2\", \"PRRC_1\", \"$B\", true]]")"
  check revision "$(record PRRC_1 | jq -r .data.revision)" "$A"
  check basis "$(record PRRC_1 | jq -r .basis)" \
    "2:2026-09-02T12:00:00Z:false"
  check resolved "$(q -s 'map({(.id): .data.resolved}) | add')" \
    "$(json '{"IC_1": null, "PRRC_1": false, "PRRC_4": true,
    "PRRC_5": false, "IC_2": null, "PRR_1": null}')"
  check conversation "$(record IC_1 | jq -c .data.comments)" "$(json '[{
    "id": "IC_1", "author": {"name": "Carol Commenter",
      "email": "carol@example.org", "username": "carol", "me": false},
    "revision": null, "text": "Thanks for the patch.",
    "created": "2026-09-01T10:00:00Z", "reply_to": null, "draft": false}]')"
  check review "$(record PRR_1 | jq -c '.data.comments[0]
    | [.text, .revision]')" "[\"LGTM\",\"$C\"]"
  check ghost "$(record PRRC_5 | jq -r '.data.comments[0].author.username')" \
    ghost
}

ISSUE_COMMENTS="$REPO/issues/12/comments?per_page=100&page"

test_issue() {
  login
  route GET "$REPO/issues/12" issue.json
  route GET "$ISSUE_COMMENTS=1" issue-comments.json
  call tracker issue 12
  check status "$STATUS" 0
  check envelope "$(q '[.id, .source, .role, .kind, .basis, .links,
    .notes]')" "$(json '["12", "https://github.com/example/widget",
    "tracker", "issue", "2026-09-03T10:00:00Z", [["issue", "12"]], {}]')"
  check data "$(q '.data | del(.comments)')" "$(json '{
    "title": "The widget deadlocks on resize", "type": "Bug",
    "status": "open", "closed": false, "priority": null,
    "assignee": {"name": "alice", "email": null, "username": "alice",
      "me": true},
    "reporter": {"name": "carol", "email": null, "username": "carol",
      "me": false},
    "created": "2026-09-01T09:00:00Z", "updated": "2026-09-03T10:00:00Z",
    "url": "https://github.com/example/widget/issues/12",
    "text": "Resizing twice hangs.", "related": []}')"
  check comments "$(q '.data.comments')" "$(json '[
    {"id": "6361857913", "author": {"name": "bob", "email": null,
      "username": "bob", "me": false},
     "text": "Reproduced on main.", "created": "2026-09-02T09:00:00Z"},
    {"id": "6361857914", "author": {"name": "ghost", "email": null,
      "username": "ghost", "me": false},
     "text": "Me too.", "created": "2026-09-03T10:00:00Z"}]')"
}

# Issues are public: no token, no user
test_issue_anonymous() {
  route GET "$REPO/issues/12" issue.json
  route GET "$ISSUE_COMMENTS=1" issue-comments.json
  call tracker issue 12
  check status "$STATUS" 0
  check me "$(q .data.assignee.me)" false
  check auth "$(log '[.[].auth | select(.)] | unique')" '["none"]'
}

test_issue_closed() {
  route GET "$REPO/issues/13" issue-closed.json
  route GET "${ISSUE_COMMENTS/12/13}=1" empty-list.json
  call tracker issue 13
  check status "$STATUS" 0
  check data "$(q '.data | [.status, .closed, .type, .assignee, .text,
    .comments]')" '["closed",true,null,null,"",[]]'
}

test_issue_pull_request() {
  route GET "$REPO/issues/7" issue-pr.json
  call tracker issue 7
  check status "$STATUS" 1
  check_has stderr "$ERR" "#7 is a pull request"
  check requests "$(requests)" "GET $REPO/issues/7"
}

# A full page of comments asks for the next one
test_issue_comment_pages() {
  jq -c '[range(100) | {id: ., user: {login: "bob"}, body: "x",
    created_at: "2026-09-02T00:00:00Z"}]' -n > "$TEST_DIR/page1.json"
  route GET "$REPO/issues/12" issue.json
  route GET "$ISSUE_COMMENTS=1" "$TEST_DIR/page1.json"
  route GET "$ISSUE_COMMENTS=2" issue-comments.json
  call tracker issue 12
  check status "$STATUS" 0
  check count "$(q '.data.comments | length')" 102
  check last "$(q -r '.data.comments[-1].id')" 6361857914
}

test_issue_http_error() {
  route GET "$REPO/issues/12" - 404
  call tracker issue 12
  check status "$STATUS" 1
  check_has stderr "$ERR" "Cannot read $REPO/issues/12"
}

test_search() {
  local query=repo%3Aexample%2Fwidget%20is%3Aissue%20label%3Abug
  query+=%20%22dead%20lock%22
  route GET "$API/search/issues?q=$query&per_page=100" search.json
  route GET "$REPO/issues/12" issue.json
  route GET "$ISSUE_COMMENTS=1" issue-comments.json
  route GET "$REPO/issues/13" issue-closed.json
  route GET "${ISSUE_COMMENTS/12/13}=1" empty-list.json
  call tracker search <<< 'label:bug "dead lock"'
  check status "$STATUS" 0
  check ids "$(q -s '[.[].id]')" '["12","13"]'
}

test_search_no_query() {
  call tracker search < /dev/null
  check status "$STATUS" 1
  check_has stderr "$ERR" "No QUERY on stdin"
}

test_comment() {
  export GITHUB_TOKEN=$TOKEN
  route POST "$REPO/issues/12/comments" comment-created.json 201
  call tracker comment 12 <<< 'Thanks, "fixed" \o/'
  check status "$STATUS" 0
  check out "$OUT" ""
  check requests "$(requests)" "POST $REPO/issues/12/comments"
  check body "$(body POST)" '{"body":"Thanks, \"fixed\" \\o/\n"}'
  check auth "$(log '[.[].auth | select(.)]')" '["stdin"]'
}

test_comment_error() {
  route POST "$REPO/issues/12/comments" - 401
  call tracker comment 12 <<< 'x'
  check status "$STATUS" 1
  check_has stderr "$ERR" "Cannot comment on #12"
}

test_transition() {
  export GITHUB_TOKEN=$TOKEN
  route PATCH "$REPO/issues/12" issue-closed.json
  call tracker transition 12 closed
  check status "$STATUS" 0
  check out "$OUT" ""
  check body "$(body PATCH)" '{"state":"closed"}'
  : > "$FAKE_LOG"
  call tracker transition 12 open
  check reopen "$(body PATCH)" '{"state":"open"}'
}

test_runs() {
  route GET "$REPO/actions/runs?head_sha=$C&per_page=100" runs.json
  call ci runs "$C"
  check status "$STATUS" 0
  check ids "$(q -s '[.[].id]')" '["501","502","503","504"]'
  check envelope "$(record 501 | jq -c '[.source, .role, .kind, .basis,
    .notes]')" \
    '["https://github.com/example/widget","ci","run","completed:success",{}]'
  check data "$(record 501 | jq -c .data)" "$(json "{\"commit\": \"$C\",
    \"status\": \"done\", \"result\": \"pass\",
    \"started\": \"2026-09-04T10:01:00Z\",
    \"finished\": \"2026-09-04T10:09:30Z\",
    \"url\": \"https://github.com/example/widget/actions/runs/501\",
    \"config\": {\"workflow\": \"Tests\", \"event\": \"pull_request\",
      \"branch\": \"lock\"}}")"
  check running "$(record 502 | jq -c '.data | [.status, .result,
    .finished]')" '["running",null,null]'
  check results "$(q -s '[.[].data.result]')" \
    '["pass",null,"error","timeout"]'
}

# A run links the pull requests of its own repository, not of forks
test_run_links() {
  route GET "$REPO/actions/runs/501" run.json
  call ci run 501
  check status "$STATUS" 0
  check links "$(q .links)" "[[\"commit\",\"$C\"],[\"change\",\"7\"]]"
}

# GitHub ignores case in OWNER and NAME, and prints them its own way
test_run_links_case() {
  local ADDR=https://github.com/Example/Widget
  route GET "$API/repos/Example/Widget/actions/runs/501" run.json
  call ci run 501
  check status "$STATUS" 0
  check links "$(q .links)" "[[\"commit\",\"$C\"],[\"change\",\"7\"]]"
}

test_suites() {
  route GET "$REPO/actions/runs/501/jobs?per_page=100" jobs.json
  call ci suites 501
  check status "$STATUS" 0
  check build "$(record 9001 | jq -c '[.kind, .basis, .links, .data]')" \
    "$(json '["suite", "completed:success", [], {"run": "501",
      "name": "build", "result": "pass", "counts": {}, "duration": 150,
      "url": "https://github.com/example/widget/actions/runs/501/job/9001"}]')"
  check results "$(q -s '[.[].data | [.name, .result, .duration]]')" \
    "$(json '[["build", "pass", 150], ["test", "fail", 330],
    ["docs", "skip", 0], ["deploy", null, null]]')"
}

test_logs_job() {
  route GET "$REPO/actions/jobs/9001" job.json
  call ci logs 9001
  check status "$STATUS" 0
  check log "$(q '[.id, .kind, (.data | del(.url))]')" "$(json '["9001.log",
    "log", {"of": "9001", "name": "build.log", "size": null}]')"
  check url "$(q -r .data.url)" "$REPO/actions/jobs/9001/logs"
}

# A run's logs come as one archive; its artifacts too
test_logs_run() {
  route GET "$REPO/actions/jobs/501" - 404
  route GET "$REPO/actions/runs/501" run.json
  route GET "$REPO/actions/runs/501/artifacts?per_page=100" artifacts.json
  call ci logs 501
  check status "$STATUS" 0
  check logs "$(q -s '[.[] | [.id, (.data | del(.url))]]')" "$(json '[
    ["501.zip", {"of": "501", "name": "logs.zip", "size": null}],
    ["7001", {"of": "501", "name": "test-results.zip", "size": 52341}]]')"
  check urls "$(q -r .data.url)" \
    "$REPO/actions/runs/501/logs"$'\n'"$REPO/actions/artifacts/7001/zip"
}

test_logs_missing() {
  route GET "$REPO/actions/jobs/77" - 404
  route GET "$REPO/actions/runs/77" - 404
  call ci logs 77
  check status "$STATUS" 1
  check out "$OUT" ""
}

test_retest() {
  export GITHUB_TOKEN=$TOKEN
  route POST "$REPO/actions/runs/501/rerun" - 201
  call ci retest 501 <<< '{"reason": "flaky"}'
  check status "$STATUS" 0
  check requests "$(requests)" "POST $REPO/actions/runs/501/rerun"
  check auth "$(log '[.[].auth | select(.)]')" '["stdin"]'
}

test_retest_error() {
  route POST "$REPO/actions/runs/501/rerun" - 403
  call ci retest 501 <<< '{"reason": "flaky"}'
  check status "$STATUS" 1
  check_has stderr "$ERR" "Cannot run 501 again"
}

run() {
  local failed=$FAILED
  local unexpected
  TEST=$1
  TEST_DIR=$DIR/$1
  mkdir -p "$TEST_DIR/home"
  export HOME=$TEST_DIR/home
  export FAKE_LOG=$TEST_DIR/log
  export FAKE_ROUTES=$TEST_DIR/routes
  : > "$FAKE_LOG"
  : > "$FAKE_ROUTES"
  "$1" < /dev/null
  unexpected=$(jq -r 'select(.unexpected) | "\(.method) \(.url)"' "$FAKE_LOG")
  check "unexpected requests" "$unexpected" ""
  unset GITHUB_TOKEN FAKE_GH_TOKEN
  if [ $FAILED -eq $failed ]; then
    echo "ok $1"
  else
    echo "not ok $1"
  fi
}

if [ "$1" == "-h" -o "$1" == "--help" ]; then
  usage
  exit 0
fi
command -v jq > /dev/null || die "jq is not installed"
trap cleanup EXIT
export FAKE_FIXTURES=$CURDIR/fixtures
export PATH=$CURDIR/bin:$PATH
unset GITHUB_TOKEN FAKE_GH_TOKEN

TESTS=("$@")
[ $# -gt 0 ] || TESTS=($(declare -F | cut -d' ' -f3 | grep '^test_'))
for test in "${TESTS[@]}"; do
  declare -F "$test" > /dev/null || die "No such test: $test"
  run "$test"
done
[ $FAILED -eq 0 ] || die "$FAILED failed"
